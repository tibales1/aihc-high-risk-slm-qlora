# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Hugging Face access token, required to download meta-llama/Llama-3.1-8B.
# The model is gated: request access at https://huggingface.co/meta-llama/Llama-3.1-8B
# before the token will work. Create a token at https://huggingface.co/settings/tokens
# with the "Read" role.
HUGGINGFACE_TOKEN=hf_your_token_here
